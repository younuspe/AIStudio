{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Studio Desktop",
  "version": "0.1.0",
  "identifier": "com.aistudio.desktopfresh",
  "build": {
    "beforeBuildCommand": "",
    "beforeDevCommand": "",
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [{
      "title": "AI Studio Desktop",
      "width": 1440,
      "height": 900,
      "minWidth": 1080,
      "minHeight": 680,
      "resizable": true
    }],
    "security": {
      "csp": "default-src 'self' asset: http://asset.localhost; img-src 'self' asset: data: https:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost https: http://127.0.0.1:11434 http://localhost:11434"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "category": "DeveloperTool",
    "shortDescription": "Native AI app-building workspace"
  }
}
